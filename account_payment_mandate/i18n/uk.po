#. module: account_payment_mandate
#: model_terms:ir.actions.act_window,help:account_payment_mandate.mandate_action
msgid ""
"A Banking Mandate is a document signed by your customer that gives you the "
"autorization to do one or several operations on his bank account."
msgstr ""
"Банківський мандат — документ, підписаний вашим клієнтом, який надає вам "
"дозвіл виконувати одну або кілька операцій з його банківським рахунком."

#. module: account_payment_mandate
#: model:ir.model.fields,help:account_payment_mandate.field_account_bank_statement_line__mandate_required
#: model:ir.model.fields,help:account_payment_mandate.field_account_move__mandate_required
#: model:ir.model.fields,help:account_payment_mandate.field_account_payment_line__mandate_required
#: model:ir.model.fields,help:account_payment_mandate.field_account_payment_method__mandate_required
#: model:ir.model.fields,help:account_payment_mandate.field_account_payment_order__mandate_required
msgid ""
"Activate this option if this payment method requires your customer to sign a"
" direct debit mandate with your company."
msgstr ""
"Увімкніть цю опцію, якщо цей спосіб оплати вимагає від клієнта підписати з "
"вашою компанією мандат на пряме дебетування."

#. module: account_payment_mandate
#: model_terms:ir.ui.view,arch_db:account_payment_mandate.view_mandate_form
msgid "Are you sure the next debit with this mandate will be the final debit?"
msgstr "Ви впевнені, що наступне списання за цим мандатом буде останнім?"

#. module: account_payment_mandate
#: model_terms:ir.ui.view,arch_db:account_payment_mandate.view_mandate_form
